# --- AI (2차 문맥 교정·훈수) ---
# AI is enabled when OPENAI_API_KEY is set (AI_ENABLED=false turns it off anyway).
OPENAI_API_KEY=
# AI_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=6000
MAX_TEXT_LENGTH=1000
# 비용·어뷰징 방어: 이보다 긴 문장은 규칙 교정만, AI 출력 토큰 상한
AI_MAX_INPUT_CHARS=150
AI_MAX_OUTPUT_TOKENS=400
# 하루 AI 호출 시도 상한 (훈수 차감과 별개)
FREE_DAILY_AI_ATTEMPTS=60
PRO_DAILY_AI_ATTEMPTS=1000

# --- 월 AI 예산 가드 (UTC 월 기준) ---
AI_MONTHLY_WARN_USD=100
AI_MONTHLY_CAP_USD=200
# gpt-4o-mini 단가(USD / 1M tokens) — 출시 전 OpenAI 현재 가격으로 확인
OPENAI_PRICE_INPUT_PER_M=0.15
OPENAI_PRICE_OUTPUT_PER_M=0.60
# Slack 또는 Discord incoming webhook (경고·중단 알림)
BUDGET_ALERT_WEBHOOK_URL=

# --- Supabase (auth + quota) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects; leave empty to verify tokens with the project's JWKS.
SUPABASE_JWT_SECRET=

# Local dev without Supabase: trusts X-Dev-User-Id header, in-memory quota. NEVER in production.
ALLOW_INSECURE_DEV_AUTH=false

# --- Quota / BM ---
FREE_DAILY_AI_LIMIT=5
PRO_DAILY_AI_LIMIT=300
AD_REWARD_AMOUNT=3
MAX_AD_REWARDS_PER_DAY=5
